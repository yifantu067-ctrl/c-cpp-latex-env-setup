{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++ 编译并调试 (F5)",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}\\build\\${fileBasenameNoExtension}.exe",
            "args": [],
            "cwd": "${fileDirname}",
            "preLaunchTask": "build",
            "terminal": "integrated",
            "stopOnEntry": false,
            "sourceLanguages": ["cpp", "c"]
        },
        {
            "name": "Python 运行并调试 (F5)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true
        }
    ]
}